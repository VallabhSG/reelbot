# --- general ---
SERIES_FILE=series/everyday-boss-fights.yaml
DATA_DIR=data
TIMEZONE=Asia/Kolkata
DRY_RUN=true              # flip to false once every key below is filled in

# --- LLM planner: any OpenAI-compatible endpoint (Groq has a free tier) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- Higgsfield: console.higgsfield.ai -> API keys (shown once) ---
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# --- ElevenLabs (Music API needs a paid plan); or set music.provider=library in the series file ---
ELEVENLABS_API_KEY=

# --- Cloudflare R2 (or any S3-compatible bucket with a public URL) ---
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=reelbot-media           # PUBLIC (r2.dev enabled): Instagram pulls the MP4 from here
S3_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
S3_STATE_BUCKET=reelbot-state     # PRIVATE: DB + in-flight renders; needed on GitHub Actions

# --- Telegram review bot: @BotFather token + your chat id ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Instagram API with Instagram Login (professional account) ---
IG_USER_ID=
IG_ACCESS_TOKEN=          # long-lived token; bootstraps only, refreshed copy lives in the DB
IG_GRAPH_VERSION=
